# Database
# Supabase Pooler: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://user:password@localhost:5432/uniclear"

# JWT
JWT_ACCESS_SECRET="your-access-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"
CLIENT_URL="http://localhost:3000"

# Storage
STORAGE_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cache
CACHE_PROVIDER="memory"
REDIS_URL=""

# Email
EMAIL_PROVIDER="mailpit"        # mailpit | resend
EMAIL_FROM="UniClear <noreply@uniclear.ng>"
APP_URL="http://localhost:3000"

# Mailpit (local dev — run via docker-compose)
SMTP_HOST="localhost"
SMTP_PORT=1025


# Storage (local | supabase | cloudinary)
STORAGE_PROVIDER="local"
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_S3_ENDPOINT="https://ltqyaavtoiqaibfcnnsj.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="eu-central-2"
SUPABASE_STORAGE_BUCKET="clearance-documents"